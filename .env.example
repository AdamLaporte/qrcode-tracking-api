# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env ne doit jamais être commité (il est dans .gitignore).

# --- Base de données PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=qrcode
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_SCHEMA=projet

# --- API ---
PORT=5000
# Préfixe de chemin si l'API est servie derrière un proxy (vide en local)
ROOT_PATH=
# URL publique de l'API (utilisée par la CLI)
BASE_URL=http://localhost:5000
# URL encodée dans les QR codes suivis : chaque scan passe par /scan/{id}
SCAN_BASE_URL=http://localhost:5000/scan
# Dossier où sont enregistrées les images des QR codes
QRCODE_OUTPUT_DIR=static/qrcodes
